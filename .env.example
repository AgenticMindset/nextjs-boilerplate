# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored; never commit real keys.

# Groq (https://console.groq.com/keys) - powers every agent feature via the
# Vercel AI SDK: tech stack advisor, wargame, negotiator, problem solver,
# tokenomics stress test, and voice coach. Free tier on this account is
# capped at 8,000 tokens/minute (gpt-oss-120b), shared across all features.
GROQ_API_KEY=

# Upstash Redis (https://console.upstash.com) - REST-based Redis used only
# for per-IP rate limiting (lib/rate-limit.ts) across all agent routes.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Pinecone (https://app.pinecone.io) - vector index for the Market Wargame
# agent's RAG corpus (lib/wargame/retrieval.ts). Requires running
# `npm run wargame:setup-index` then `npm run wargame:ingest` once to
# create and populate the "wargame-corpus" index before first use.
PINECONE_API_KEY=

# Tavily (https://app.tavily.com) - live web search used by the Market
# Wargame agent (lib/wargame/retrieval.ts) and the Tech Stack Advisor's
# research_current_landscape tool (lib/agent/tools.ts).
TAVILY_API_KEY=

# Replicate (https://replicate.com/account/api-tokens) - hosts the
# Kokoro-82M text-to-speech model used by the Voice Coach agent's
# speak route (app/api/voice-coach/speak).
REPLICATE_API_TOKEN=
